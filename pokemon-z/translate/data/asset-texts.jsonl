{"file": "introText1.png", "kind": "body", "es": "HACE MUCHO TIEMPO,\nEL MUNDO POKÉMON\nESTUVO A PUNTO DE\nSER DESTRUIDO POR\nUNA GUERRA ATROZ", "src": "gemini-3.7-flash/vertex-flex", "es_from": "orig", "in_core": true, "ko": null}
{"file": "introText2.png", "kind": "body", "es": "EL REY DE AQUELLOS\nDÍAS, ÁSTER ZÉPHIR,\nCONSTRUYÓ UN\nARTEFACTO CAPAZ DE\nDEVOLVER LA VIDA", "src": "gemini-3.7-flash/vertex-flex", "es_from": "orig", "in_core": true, "ko": null}
{"file": "introText3.png", "kind": "body", "es": "DE LOS HUMANOS\nY POKÉMON QUE\nPERECÍAN EN EL\nCONFLICTO", "src": "gemini-3.7-flash/vertex-flex", "es_from": "orig", "in_core": true, "ko": null}
{"file": "introText4.png", "kind": "body", "es": "SIN EMBARGO, LA GRAN\nGUERRA NO LLEGABA A\nSU FIN", "src": "gemini-3.7-flash/vertex-flex", "es_from": "orig", "in_core": true, "ko": null}
{"file": "introText5.png", "kind": "body", "es": "LLENO DE CÓLERA, EL REY\nMODIFICÓ EL ARTEFACTO\nY LO CONVIRTIÓ EN UN\nARMA", "src": "gemini-3.7-flash/vertex-flex", "es_from": "orig", "in_core": true, "ko": null}
{"file": "introText6.png", "kind": "body", "es": "CAPAZ DE LIBERAR UN\nPODER QUE TERMINASE\nCON TODAS LAS\nBATALLAS", "src": "gemini-3.7-flash/vertex-flex", "es_from": "orig", "in_core": true, "ko": null}
{"file": "introText7.png", "kind": "body", "es": "PERO MUCHOS DETALLES\nDE LA NATURALEZA DE\nESTOS EVENTOS SE HAN\nPERDIDO CON EL TIEMPO", "src": "gemini-3.7-flash/vertex-flex", "es_from": "orig", "in_core": true, "ko": null}
{"file": "introText8.png", "kind": "body", "es": "ESTA ES TODA LA\nHISTORIA DE LO QUE\nOCURRIÓ", "src": "gemini-3.7-flash/vertex-flex", "es_from": "orig", "in_core": true, "ko": null}
